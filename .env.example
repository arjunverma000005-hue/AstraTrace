# ====================================================================
# AstraTrace — Environment Configuration Template
# SIH 2026 | Problem ID: SIH26227
# Note: Copy this file to .env for local development. Never commit .env!
# ====================================================================

# Environment Profile (development | staging | production)
APP_ENV=development
APP_NAME=AstraTrace
APP_VERSION=0.1.0

# Server Binding
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Security & CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Offline Mode Invariant
OFFLINE_MODE=true

# Storage Paths (Local relative or container absolute)
DATA_DIR=data
MODELS_DIR=models

# Database Configuration (Defaults for local PostgreSQL service)
DATABASE_URL=postgresql+psycopg://astratrace:astratrace_dev_pw@localhost:5432/astratrace
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO local instance)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_dev_access
S3_SECRET_KEY=minio_dev_secret_replace_in_prod
S3_BUCKET=astratrace-scenes
