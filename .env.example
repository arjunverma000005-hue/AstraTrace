# ====================================================================
# AstraTrace 2.0 — Environment Configuration Template
# SIH 2026 | Problem ID: SIH26227
# Ministry of Defence (MoD) | Indian Army (DGIS)
# ====================================================================

# Deployment Profile: OFFLINE_PROFILE (default, 100% air-gapped) | WEB_DEMO_PROFILE
DEPLOYMENT_PROFILE=OFFLINE_PROFILE
OFFLINE_MODE=true

# Application Metadata
APP_ENV=production
APP_NAME=AstraTrace
APP_VERSION=2.0.0
LOG_LEVEL=INFO

# Server Binding
API_HOST=0.0.0.0
API_PORT=8000

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Three-Tier Storage Paths
IMMUTABLE_DATA_DIR=data/raw
CATALOG_DB_PATH=data/catalog.db
STATE_DB_PATH=data/state.db
SCRATCH_DIR=data/scratch
MODELS_DIR=models/weights
INDEXES_DIR=indexes/faiss
EVALUATION_DIR=data/evaluation

# Database Configuration (SQLite default for offline air-gapped execution)
DATABASE_URL=sqlite:///./data/catalog.db
STATE_DATABASE_URL=sqlite:///./data/state.db

# Vector Index Configuration
VECTOR_DIMENSION=512
SIMILARITY_METRIC=COSINE
FAISS_INDEX_PATH=indexes/faiss/astratrace.index
