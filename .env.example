# ====================================================================
# AstraTrace — Environment Configuration Template
# SIH 2026 | Problem ID: SIH26227
# Note: Copy this file to .env for local development. Never commit .env!
# ====================================================================

# Environment Profile (development | staging | production)
APP_ENV=production
APP_NAME=AstraTrace
APP_VERSION=0.1.0

# Server Binding (PORT is set dynamically by cloud PaaS like Render/Railway)
PORT=8000
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Security & CORS (comma-separated list of allowed origins or * for production)
CORS_ORIGINS=*

# Operational Invariant: Offline Mode (Strictly offline, air-gapped)
OFFLINE_MODE=true

# Storage Paths (Local relative or container absolute)
DATA_DIR=data
MODELS_DIR=models

# Database Configuration (SQLite default for standalone/cloud deployment)
DATABASE_URL=sqlite:///./data/catalog.db
# DATABASE_URL=postgresql+psycopg://astratrace:astratrace_dev_pw@localhost:5432/astratrace
REDIS_URL=redis://localhost:6379/0

# Object Storage (Optional for distributed storage; local files used in offline mode)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_dev_access
S3_SECRET_KEY=minio_dev_secret_replace_in_prod
S3_BUCKET=astratrace-scenes
